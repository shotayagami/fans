#!/usr/bin/env bash
# Seal fans-secret from an env file kept outside the repo, for k8s/overlays/production.
#   ENV_FILE=~/.env.fans script/seal-secret
# The env file holds SECRET_KEY_BASE, STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET (test mode only).
set -euo pipefail
env_file=${ENV_FILE:-$HOME/.env.fans}
[ -r "$env_file" ] || { echo "missing $env_file" >&2; exit 1; }

kubectl create secret generic fans-secret --namespace fans --dry-run=client -o yaml \
  --from-env-file "$env_file" |
  kubeseal --controller-name sealed-secrets --controller-namespace kube-system --format yaml \
  > k8s/overlays/production/sealed-secret.yaml
echo "wrote k8s/overlays/production/sealed-secret.yaml"
