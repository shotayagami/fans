<% content_for :title, "#{@post.title} | Fans" %>

<article class="post">
  <p class="muted"><%= link_to @post.plan.creator.display_name, creator_path(@post.plan.creator) %> · <%= @post.plan.name %></p>
  <h1><%= @post.title %></h1>
  <p class="muted"><%= l(@post.published_at, format: :long) %></p>

  <% if @post.viewable_by?(current_user) %>
    <% if @post.image.attached? %>
      <figure><%= image_tag @post.image, alt: "" %></figure>
    <% end %>
    <div class="post-body"><%= simple_format(@post.body) %></div>
  <% else %>
    <div class="locked">
      <p>この投稿は「<%= @post.plan.name %>」(<%= yen(@post.plan.price) %> / 月) の支援者だけが読めます。</p>
      <% if user_signed_in? %>
        <%= button_to "このプランで支援する", plan_checkout_path(@post.plan), class: "button", data: { turbo: false } %>
      <% else %>
        <%= link_to "ログインして支援する", new_user_session_path, class: "button" %>
      <% end %>
    </div>
  <% end %>
</article>
