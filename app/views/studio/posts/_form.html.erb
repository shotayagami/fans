<%= form_with model: [ :studio, post ], class: "form" do |f| %>
  <%= render "shared/errors", record: post %>

  <div class="field">
    <%= f.label :plan_id %>
    <%= f.collection_select :plan_id, current_user.plans.order(:price), :id, :name, {}, required: true %>
  </div>

  <div class="field">
    <%= f.label :title %>
    <%= f.text_field :title, required: true, maxlength: 100 %>
  </div>

  <div class="field">
    <%= f.label :body %>
    <%= f.text_area :body, rows: 10, required: true %>
  </div>

  <div class="field">
    <%= f.label :image %>
    <%= f.file_field :image, accept: Post::IMAGE_TYPES.join(",") %>
    <p class="hint">PNG / JPEG / WebP / GIF、5MB まで。</p>
  </div>

  <div class="field">
    <%= f.label :published_at %>
    <%= f.datetime_field :published_at %>
    <p class="hint">空欄にすると下書きになります。</p>
  </div>

  <%= f.submit "保存する", class: "button" %>
<% end %>
